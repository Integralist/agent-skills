{
  "skillListingBudgetFraction": 0.04,
  "env": {
	  "CLAUDE_CODE_ENABLE_AUTO_MODE": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_WORKFLOWS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(fd *)",
      "Bash(find *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(git status *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(make *)",
      "Bash(rg *)",
      "Bash(tail *)",
      "Bash(wc *)"
    ],
    "ask": [
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *--visibility*)",
      "Bash(gh repo deploy-key delete *)",
      "Bash(gh release delete *)",
      "Bash(gh release delete-asset *)",
      "Bash(gh secret set *)",
      "Bash(gh secret delete *)",
      "Bash(gh variable delete *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh label delete *)",
      "Bash(gh gist delete *)",
      "Bash(gh ssh-key delete *)",
      "Bash(gh gpg-key delete *)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *-X PATCH*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api graphql *mutation*)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(gh release create *)",
      "Bash(gh gist create *)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "gh api or GitHub GraphQL calls that delete, overwrite, or change the visibility or permissions of GitHub resources, however the HTTP method or flags are spelled"
    ]
  },
  "outputStyle": "concise",
  "model": "claude-opus-5-5",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -message \"Claude Code needs your input\" -sound Sosumi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -message \"Claude Code finished\" -sound default"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/log-session-cost.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "ask-questions-if-underspecified@trailofbits": true,
    "atlassian@claude-plugins-official": true,
    "ciam@fastly-agent-skills-internal": true,
    "code-review@claude-plugins-official": true,
    "code-review@fastly-agent-skills-internal": false,
    "code-simplifier@claude-plugins-official": true,
    "commit@fastly-agent-skills-internal": true,
    "crit@crit": true,
    "delegate@fastly-agent-skills-internal": true,
    "differential-review@trailofbits": true,
    "elevation@fastly-agent-skills-internal": true,
    "fastly-agent-toolkit@fastly-agent-toolkit": true,
    "google-workspace@fastly-agent-skills-internal": true,
    "gopls-lsp@claude-plugins-official": true,
    "insecure-defaults@trailofbits": true,
    "is-it-safe-to-run@fastly-agent-skills-internal": true,
    "observability@fastly-agent-skills-internal": true,
    "portal@fastly-agent-skills-internal": true,
    "security-guidance@claude-plugins-official": true,
    "sharp-edges@trailofbits": true
  },
  "extraKnownMarketplaces": {
    "fastly-agent-toolkit": {
      "source": {
        "source": "git",
        "url": "https://github.com/fastly/fastly-agent-toolkit.git"
      }
    },
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    }
  },
  "viewMode": "verbose",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Thinking"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "showThinkingSummaries": true,
  "theme": "dark-ansi"
}
