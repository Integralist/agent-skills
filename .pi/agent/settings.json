{
  "defaultProvider": "github-copilot",
  "defaultModel": "pi-auto-model/auto",
  "defaultThinkingLevel": "xhigh",
  "modelThinkingLevels": {
    "github-copilot/gpt-6-luna": "xhigh",
    "github-copilot/gpt-6.1-sol": "xhigh"
  },
  "hideThinkingBlock": true,
  "theme": "nord-contrast",
  "packages": [
    "npm:pi-intercom",
    "git:github.com/Integralist/pi-auto-model",
    "git:github.com/Integralist/pi-statusbar",
    "git:github.com/Integralist/pi-subagents",
    "git:github.com/Integralist/pi-btw",
    "git:github.com/Integralist/pi-transcript-enhancer",
    "git:github.com/Integralist/pi-context-shake",
    "git:github.com/Integralist/pi-skill-argument-hints",
    "git:github.com/Integralist/pi-event-hooks",
    "git:github.com/Integralist/pi-prompt-history",
    "git:github.com/Integralist/pi-clean-view",
    {
      "source": "git:github.com/fastly/agent-skills-internal",
      "skills": [
        "plugins/ciam/skills/**",
        "plugins/elevation/skills/**",
        "plugins/observability/skills/**",
        "plugins/portal/skills/**"
      ]
    }
  ],
  "enabledModels": [
    "pi-auto-model/auto",
    "amazon-bedrock/global.anthropic.claude-haiku-5-5",
    "amazon-bedrock/global.anthropic.claude-sonnet-5-5",
    "amazon-bedrock/global.anthropic.claude-opus-5-5",
    "github-copilot/gpt-6-luna",
    "github-copilot/gpt-6-sol",
    "github-copilot/gpt-6-astra",
    "github-copilot/gpt-6.1-sol",
    "github-copilot/kimi-k3",
    "google-vertex/gemini-3.1-pro-preview",
    "google-vertex/gemini-3.8-flash",
    "google-vertex/gemini-4-argon"
  ]
}
