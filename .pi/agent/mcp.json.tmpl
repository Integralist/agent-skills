{
  "mcpServers": {
    "atlassian": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.atlassian.com/v1/mcp/authv2", "--transport", "http-only"]
    },
    "fastly": {
      "command": "npx",
      "args": [
        "-p",
        "@fastly/mcp",
        "fastly-mcp"
      ]
    },
    "google-workspace": {
      "command": "bash",
      "args": ["-c", "exec \"$HOME/.local/share/google-workspace-mcp/launch.sh\""]
    },
    "gopls": {
      "command": "gopls",
      "args": ["mcp"]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{{ op://Employee/context7 MCP/credential }}"
      }
    },
    "elevation": {
      "command": "bash",
      "args": ["-c", "PATH=\"$HOME/.local/bin:$PATH\" exec uv run --script \"$HOME/.pi/agent/git/github.com/fastly/agent-skills-internal/plugins/elevation/skills/elevation-k8s-triage/scripts/radar_mcp_proxy.py\""]
    },
    "grafana": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://{{ op://Employee/Grafana MCP/URL }}/mcp"]
    },
    "portal": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://{{ op://Employee/Portal MCP/URL }}/api/mcp-actions/v1"]
    }
  }
}
