{
  "mcpServers": {
    "atlassian": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.atlassian.com/v1/mcp/authv2", "--transport", "http-only"]
    },
    "fastly": {
      "command": "npx",
      "args": [
        "-p",
        "@fastly/mcp",
        "fastly-mcp"
      ]
    },
    "google-workspace": {
      "command": "bash",
      "args": ["-c", "exec \"$HOME/.local/share/google-workspace-mcp/launch.sh\""]
    },
    "gopls": {
      "command": "gopls",
      "args": ["mcp"]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{{ op://Employee/context7 MCP/credential }}"
      }
    },
    "elevation": {
      "command": "bash",
      "args": ["-c", "PATH=\"$HOME/.local/bin:$PATH\" exec uv run --script \"{{ op://Employee/Elevation MCP/scriptPath }}\""]
    },
    "grafana": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://{{ op://Employee/Grafana MCP/URL }}/mcp"]
    },
    "portal": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://{{ op://Employee/Portal MCP/URL }}/api/mcp-actions/v1"]
    },
    "slack": {
      "description": "Slack workspace search, channels, and messaging",
      "exposure": "codemode",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "{{ op://Employee/Slack MCP/clientId }}",
        "callbackUrl": "http://localhost:3118/callback",
        "scope": "search:read.public,search:read.private,search:read.mpim,search:read.im,search:read.files,search:read.users,channels:history,groups:history,mpim:history,im:history,chat:write,canvases:read,canvases:write,reactions:write,users:read,users:read.email,channels:read,groups:read,im:read,mpim:read,files:read,emoji:read"
      }
    }
  }
}
