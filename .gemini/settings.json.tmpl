{
  "security": {
    "auth": {
      "selectedType": "vertex-ai"
    }
  },
  "general": {
    "defaultApprovalMode": "plan",
    "previewFeatures": true,
    "sessionRetention": {
      "warningAcknowledged": true,
      "enabled": true,
      "maxAge": "30d"
    }
  },
  "mcpServers": {
    "atlassian": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.atlassian.com/v1/mcp/authv2",
        "--transport",
        "http-only"
      ]
    },
    "fastly": {
      "command": "npx",
      "args": [
        "-p",
        "@fastly/mcp",
        "fastly-mcp"
      ]
    },
    "gopls": {
      "command": "gopls",
      "args": [
        "mcp"
      ]
    },
    "google-workspace": {
      "command": "bash",
      "args": [
        "-c",
        "exec \"$HOME/.local/share/google-workspace-mcp/launch.sh\""
      ]
    },
    "github": {
      "httpUrl": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_API_TOKEN}"
      }
    },
    "portal": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://{{ op://Employee/Portal MCP/URL }}/api/mcp-actions/v1"
      ]
    }
  },
  "hooks": {
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "notify-input",
            "type": "command",
            "command": "bash -c 'terminal-notifier -message \"Gemini CLI needs your input\" -sound Sosumi; echo \"{}\"'"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "notify-finished",
            "type": "command",
            "command": "bash -c 'terminal-notifier -message \"Gemini CLI finished\" -sound default; echo \"{}\"'"
          }
        ]
      }
    ]
  }
}
